# Runtime
# Optional. Defaults to "development" when omitted.
NODE_ENV=development

# Required. API listen port.
PORT=5000

# Required. Local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/support_ticket_management

# Optional. Allowed browser origin for CORS. Defaults to http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Required. JWT signing secret (minimum 32 characters).
# Generate a unique value for your machine. Never commit real secrets.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Optional. JWT lifetime. Defaults to 7d
JWT_EXPIRES_IN=7d

# Admin seed script only (npm run seed:admin).
# Not used by public registration. Required only when seeding.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
