{
  "info": {
    "_postman_id": "a7c3e8f1-5b2d-4c9a-9e61-stm-phase13-001",
    "name": "Support Ticket Management",
    "description": "API collection for the Support Ticket Management System.\n\n1. Set `baseUrl` (default http://localhost:5000/api).\n2. Run Register or Login — scripts store `token`.\n3. Create Ticket stores `ticketId`.\n4. Use Bearer token automatically via collection auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.token) pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo.user@example.com\",\n  \"password\": \"UserSecurePass123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Public registration. Always creates role USER. Extra fields such as role are rejected."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    if (body?.data?.user?.role === 'ADMIN') {",
                  "      pm.collectionVariables.set('adminToken', body.data.token);",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.user@example.com\",\n  \"password\": \"UserSecurePass123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires Bearer token. Returns sanitized user (no password)."
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    pm.collectionVariables.set('adminToken', body.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeThisStrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Use the seeded admin credentials from your local backend/.env (placeholders shown)."
          }
        }
      ]
    },
    {
      "name": "User Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const id = body?.data?.ticket?._id;",
                  "  if (id) pm.collectionVariables.set('ticketId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot reset password\",\n  \"description\": \"The reset link expires immediately and never arrives in inbox.\",\n  \"category\": \"Account\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": "{{baseUrl}}/tickets"
          }
        },
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets?page=1&limit=10&sortBy=createdAt&sortOrder=desc"
          }
        },
        {
          "name": "User Ticket Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets/stats",
            "description": "Dashboard counts for the authenticated user."
          }
        },
        {
          "name": "Get Ticket Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Update Ticket",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot reset password - updated\",\n  \"description\": \"Still failing after clearing cache. Please escalate.\",\n  \"category\": \"Account\",\n  \"priority\": \"URGENT\"\n}"
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Cannot change status. Blocked when ticket is RESOLVED or CLOSED."
          }
        },
        {
          "name": "Delete Ticket",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Blocked when ticket is RESOLVED or CLOSED."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Additional screenshots attached in the next reply.\"\n}"
            },
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Activity",
      "item": [
        {
          "name": "Get Ticket Activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/activity?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const first = body?.data?.notifications?.[0];",
                  "  if (first?._id) pm.collectionVariables.set('notificationId', first._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications?page=1&limit=20"
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/check",
            "description": "Requires ADMIN role."
          }
        },
        {
          "name": "Admin List Tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/tickets?page=1&limit=10&sortBy=createdAt&sortOrder=desc"
          }
        },
        {
          "name": "Admin Ticket Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/tickets/stats"
          }
        },
        {
          "name": "Admin Get Ticket Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Admin Update Ticket Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/status",
            "description": "CLOSED is terminal. Invalid transitions return 400."
          }
        },
        {
          "name": "Admin Update Ticket Priority",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"URGENT\"\n}"
            },
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/priority"
          }
        }
      ]
    }
  ]
}